# ============================================================
# Diagnex Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# Database
DATABASE_URL=postgresql://diagnex:changeme@localhost:5432/diagnex
# For local dev/testing with SQLite:
# DATABASE_URL=sqlite:///./diagnex.db

# JWT Auth
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Encryption (Fernet key — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=CHANGE_ME_GENERATE_FERNET_KEY

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# CORS
FRONTEND_URL=http://localhost:3000

# Admin seed
ADMIN_EMAIL=admin@diagnex.local
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
