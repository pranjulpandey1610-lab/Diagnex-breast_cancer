# Diagnex Backend Environment Variables

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET_KEY=your-supabase-jwt-secret
# Fernet key for private local report encryption; generate with
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
REPORT_ENCRYPTION_KEY=replace-with-a-fernet-key
ORTHANC_URL=http://localhost:8042
ORTHANC_USERNAME=orthanc
ORTHANC_PASSWORD=change-me

# Database
# Note: Use the connection pooler URL (Transaction mode) for pgBouncer or direct connection if supported
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Redis & Celery (for background tasks)
REDIS_HOST=localhost
REDIS_PORT=6379

# Security (Legacy, used for other hashing if needed, but Supabase handles Auth now)
SECRET_KEY=your-super-secret-key-do-not-use-in-production
ALGORITHM=HS256
